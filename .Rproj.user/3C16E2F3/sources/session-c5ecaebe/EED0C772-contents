library(Biostrings)
library(seqinr)
library(msa)

Pfluor.16S.1 <- readDNAStringSet("P.fluorescens.16S.fasta")
Pfluor.16S.2 <- readDNAStringSet("P.fluorescens.16S.2.fasta")
Pfluor.16S.VUN <- readDNAStringSet("P.fluorescens.16S.VUN.fasta")
Pfluor.16S.3 <- readDNAStringSet("P.fluorescens.16S.3.fasta")
Pfluor.16S.comp <- readDNAStringSet("P.fluorescens.16S.complete.fasta")

P.fluor.Seq <- c(Pfluor.16S.1, Pfluor.16S.2, Pfluor.16S.3, Pfluor.16S.VUN, Pfluor.16S.comp)

names(P.fluor.Seq) <- c("Pf.1", "Pf.2", "Pf.3", "Pf.VUN", "Pf.comp")

P.fluor.Seq

msaMuscle(P.fluor.Seq)

print(P.fluor.Seq, show = "complete")

myConsensus <- msa(P.fluor.Seq)
myAln <- as(myConsensus, "DNAStringSet")
nchar(myConsensus)
sum(letterFrequency(myAln, "-"))

calculate_gc <- function(sequence){
  sequence <- toupper(sequence)
  gc_count <- sum(charToRaw(sequence) %in% charToRaw("GC"))
  gc_percent <- (gc_count / nchar(sequence)) * 100
  return(gc_percent)
}
gc_content <- calculate_gc(myAln)
cat("GC Content (%):", gc_content, "\n")


myConsensus.2 <- msaConvert(myConsensus, type = "seqinr::alignment")
distance <- dist.alignment(myConsensus.2, "identity")
as.matrix(distance)[2:10, "Pfluor.16S.1", drop = FALSE]

library(ape)

P.fluor.tree <- nj(distance)
plot(P.fluor.tree, main="Phylogenetic Tree of P.fluorescens 16S")

library(phangorn)

Alignment_phyDat <- msaConvert(myConsensus, type="phangorn::phyDat")
write.phyDat(Alignment_phyDat, "alignment.fasta", format = "fasta")
